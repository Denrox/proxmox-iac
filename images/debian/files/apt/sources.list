# Internal re-signing Debian mirror; keys from http://admin.mirror.intra/api/pubkey/<host> into /etc/apt/keyrings/.

deb [signed-by=/etc/apt/keyrings/deb.debian.org.asc] http://mirror.intra/deb.debian.org/debian trixie main non-free-firmware
deb [signed-by=/etc/apt/keyrings/security.debian.org.asc] http://mirror.intra/security.debian.org/debian-security trixie-security main non-free-firmware
deb [signed-by=/etc/apt/keyrings/deb.debian.org.asc] http://mirror.intra/deb.debian.org/debian trixie-updates main non-free-firmware
deb [signed-by=/etc/apt/keyrings/deb.debian.org.asc] http://mirror.intra/deb.debian.org/debian trixie-backports main non-free-firmware
